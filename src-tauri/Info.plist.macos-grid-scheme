<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS URL scheme registration for grid://
  Bundled into MESH.app so the OS opens mesh when a grid:// link is clicked.
  Requires the app to be installed (e.g. /Applications) — not honored for bare cargo run.
-->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.grid.mesh</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>grid</string>
      </array>
    </dict>
  </array>
  <key>CFBundleDisplayName</key>
  <string>MESH</string>
</dict>
</plist>
